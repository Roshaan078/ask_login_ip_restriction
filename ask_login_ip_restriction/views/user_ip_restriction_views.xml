<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- List view for IP Restrictions -->
        <record id="view_user_ip_restriction_tree" model="ir.ui.view">
            <field name="name">user.ip.restriction.list</field>
            <field name="model">user.ip.restriction</field>
            <field name="arch" type="xml">
                <list string="IP Restrictions" editable="bottom">
                    <field name="user_id" readonly="1"/>
                    <field name="ip_address"/>
                    <field name="description"/>
                    <field name="is_active" widget="boolean"/>
                    <field name="created_date" readonly="1"/>
                </list>
            </field>
        </record>

        <!-- Form view for IP Restrictions -->
        <record id="view_user_ip_restriction_form" model="ir.ui.view">
            <field name="name">user.ip.restriction.form</field>
            <field name="model">user.ip.restriction</field>
            <field name="arch" type="xml">
                <form string="IP Restriction">
                    <sheet>
                        <group>
                            <group>
                                <field name="user_id" 
                                    options="{'no_open': False}"
                                    readonly="0"/>
                            </group>
                            <group>
                                <field name="is_active" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <group>
                            <field name="ip_address" 
                                placeholder="192.168.1.100 or 192.168.1.0/24"
                                help="IPv4, IPv6, or CIDR notation"/>
                            <field name="description" 
                                placeholder="E.g., Office, Home, VPN"/>
                        </group>
                        <group>
                            <field name="created_date" readonly="1"/>
                        </group>
                        <div class="alert alert-info" role="alert">
                            <strong>Examples:</strong>
                            <ul>
                                <li><code>192.168.1.1</code> - Single IPv4</li>
                                <li><code>192.168.1.0/24</code> - IPv4 Range (CIDR)</li>
                                <li><code>2001:db8::1</code> - Single IPv6</li>
                                <li><code>2001:db8::/32</code> - IPv6 Range (CIDR)</li>
                            </ul>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search view -->
        <record id="view_user_ip_restriction_search" model="ir.ui.view">
            <field name="name">user.ip.restriction.search</field>
            <field name="model">user.ip.restriction</field>
            <field name="arch" type="xml">
                <search string="Search IP Restrictions">
                    <field name="user_id"/>
                    <field name="ip_address"/>
                    <field name="description"/>
                    <filter name="active" string="Active" domain="[('is_active', '=', True)]"/>
                    <filter name="inactive" string="Inactive" domain="[('is_active', '=', False)]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_user" string="User" domain="[]" context="{'group_by': 'user_id'}"/>
                        <filter name="group_by_active" string="Status" domain="[]" context="{'group_by': 'is_active'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action for IP Restrictions -->
        <record id="action_user_ip_restriction" model="ir.actions.act_window">
            <field name="name">User IP Restrictions</field>
            <field name="res_model">user.ip.restriction</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_user_ip_restriction_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No IP restrictions found. Create one to restrict user logins by IP address.
                </p>
            </field>
        </record>
    </data>
</odoo>
